{
  "name": "datepack",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm --filter @datepack/core verify"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "@datepack/core": "workspace:^",
    "idb": "^8.0.3",
    "pretendard": "^1.3.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "description": "DatePack — local-first outing plans and photo memories in portable .datepack.json files. No server, no accounts.",
  "license": "MIT",
  "author": "ThreeLight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeLightStudio/datepack.git"
  },
  "homepage": "https://threelightstudio.github.io/datepack/",
  "bugs": {
    "url": "https://github.com/ThreeLightStudio/datepack/issues"
  },
  "keywords": [
    "local-first",
    "date-planner",
    "pwa",
    "offline-first",
    "react",
    "typescript",
    "datepack"
  ]
}
